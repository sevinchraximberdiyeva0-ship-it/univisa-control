generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
  INTERNATIONAL_OFFICE
  FACULTY_COORDINATOR
  STUDENT
  AUDITOR
}
enum ReviewState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  NEEDS_CORRECTION
}
enum DeliveryState {
  PENDING
  SENDING
  ACCEPTED
  DELIVERED
  FAILED
  UNKNOWN
  CANCELED
  UNAVAILABLE
  MOCK
}
enum Channel {
  SMS
  TELEGRAM
  IN_APP
}
model University {
  id String @id @default(cuid())
  name String
  slug String @unique
  timezone String @default("Asia/Tashkent")
  deliveryStart Int @default(9)
  deliveryEnd Int @default(18)
  legalApprovedAt DateTime?
  legalApprovedBy String?
  contactEmail String
  retentionDays Int @default(365)
  reminderRevision Int @default(1)
  overdueOffsets Int[] @default([1, 3, 7, 14, 30])
  createdAt DateTime @default(now())
  users User[]
  faculties Faculty[]
  students Student[]
}
model User {
  id String @id @default(cuid())
  universityId String
  university University @relation(fields:[universityId], references:[id])
  email String
  name String
  passwordHash String
  role Role
  facultyId String?
  mfaSecret String?
  mfaEnabled Boolean @default(false)
  lastTotpStep BigInt?
  active Boolean @default(true)
  sessions Session[]
  student Student?
  createdAt DateTime @default(now())
  @@unique([universityId,email])
  @@index([universityId,role])
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  csrfHash String
  mfaVerified Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model Faculty {
  id String @id @default(cuid())
  universityId String
  university University @relation(fields:[universityId], references:[id])
  name String
  students Student[]
  @@unique([id,universityId])
  @@unique([universityId,name])
}
model Student {
  id String @id @default(cuid())
  universityId String
  university University @relation(fields:[universityId], references:[id])
  userId String? @unique
  user User? @relation(fields:[userId], references:[id])
  studentNumber String
  fullName String
  facultyId String
  faculty Faculty @relation(fields:[facultyId,universityId], references:[id,universityId])
  program String
  year Int
  group String
  nationality String
  language String @default("en")
  email String
  phoneEncrypted String?
  phoneVerifiedAt DateTime?
  officerId String?
  enrollmentStatus String @default("ACTIVE")
  smsEnabled Boolean @default(true)
  telegramEnabled Boolean @default(true)
  consentAt DateTime?
  archivedAt DateTime?
  documents StudentDocument[]
  telegram TelegramConnection?
  createdAt DateTime @default(now())
  @@unique([universityId,studentNumber])
  @@unique([universityId,email])
  @@unique([id,universityId])
  @@index([universityId,facultyId,archivedAt])
}
model StudentDocument {
  id String @id @default(cuid())
  universityId String
  studentId String
  student Student @relation(fields:[studentId,universityId], references:[id,universityId])
  type String
  activeVersion Int @default(1)
  issueDate DateTime @db.Date
  expirationDate DateTime @db.Date
  officerId String?
  archivedAt DateTime?
  versions DocumentVersion[]
  renewals RenewalApplication[]
  createdAt DateTime @default(now())
  @@unique([id,universityId])
  @@index([universityId,expirationDate])
}
model DocumentVersion {
  id String @id @default(cuid())
  universityId String
  documentId String
  document StudentDocument @relation(fields:[documentId,universityId], references:[id,universityId])
  version Int
  issueDate DateTime @db.Date
  expirationDate DateTime @db.Date
  fileId String?
  verifiedBy String
  verifiedAt DateTime @default(now())
  notes String?
  @@unique([documentId,version])
  @@index([universityId,documentId])
}
model RenewalApplication {
  id String @id @default(cuid())
  universityId String
  documentId String
  document StudentDocument @relation(fields:[documentId,universityId], references:[id,universityId])
  baseVersion Int
  issueDate DateTime @db.Date
  expirationDate DateTime @db.Date
  fileId String
  state ReviewState @default(DRAFT)
  notes String?
  submittedBy String
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([universityId,state])
}
model DocumentVerification {
  id String @id @default(cuid())
  universityId String
  applicationId String
  actorId String
  state ReviewState
  notes String
  createdAt DateTime @default(now())
  @@index([universityId,applicationId])
}
model PrivateFile {
  id String @id @default(cuid())
  universityId String
  studentId String
  storageKey String @unique
  mimeType String
  size Int
  uploadedBy String
  createdAt DateTime @default(now())
  @@index([universityId,studentId])
}
model NotificationRule {
  id String @id @default(cuid())
  universityId String
  daysRemaining Int
  enabled Boolean @default(true)
  escalate Boolean @default(false)
  @@unique([universityId,daysRemaining])
}
model NotificationJob {
  id String @id @default(cuid())
  universityId String
  studentId String
  documentId String
  version Int
  kind String @default("REMINDER")
  channel Channel
  scheduledDate String
  scheduledAt DateTime
  idempotencyKey String @unique
  state DeliveryState @default(PENDING)
  providerMessageId String?
  sendingAt DateTime?
  provider String?
  retryCount Int @default(0)
  queueFailures Int @default(0)
  lastErrorCode String?
  deliveredAt DateTime?
  providerStatusAt DateTime?
  nextReceiptAt DateTime?
  receiptChecks Int @default(0)
  messageEncrypted String?
  deliveryDate String?
  acknowledgedAt DateTime?
  createdAt DateTime @default(now())
  attempts NotificationAttempt[]
  @@index([state,scheduledAt])
  @@index([universityId,studentId])
  @@index([provider,state,nextReceiptAt])
  @@index([universityId,provider,providerMessageId])
  @@unique([documentId,version,kind,channel,deliveryDate],map:"NotificationJob_delivery_day_key")
}
model NotificationAttempt {
  id String @id @default(cuid())
  jobId String
  job NotificationJob @relation(fields:[jobId], references:[id])
  state DeliveryState
  errorCode String?
  createdAt DateTime @default(now())
}
model NotificationTemplate {
  id String @id @default(cuid())
  universityId String
  language String
  kind String
  body String
  @@unique([universityId,language,kind])
}
model TelegramConnection {
  id String @id @default(cuid())
  universityId String
  studentId String @unique
  student Student @relation(fields:[studentId,universityId], references:[id,universityId])
  chatId String @unique
  linkedAt DateTime @default(now())
  blocked Boolean @default(false)
  @@unique([studentId,universityId])
}
model TelegramLinkToken {
  hash String @id
  universityId String
  studentId String
  expiresAt DateTime
  usedAt DateTime?
}
model TelegramUpdate {
  id BigInt @id
  createdAt DateTime @default(now())
}
model TelegramResponse {
  id String @id @default(cuid())
  updateId BigInt @unique
  payloadEncrypted String
  state DeliveryState @default(PENDING)
  attempts Int @default(0)
  scheduledAt DateTime @default(now())
  sendingAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@index([state,scheduledAt])
}
model WorkerHeartbeat {
  id String @id
  updatedAt DateTime @default(now())
  lastSuccessAt DateTime?
}
model SmsProviderConfiguration {
  id String @id @default(cuid())
  universityId String @unique
  provider String @default("mock")
  credentialsEncrypted String?
  monthlyQuota Int @default(1000)
  unitCost Decimal @default(0) @db.Decimal(12,4)
}
model StaffAssignment {
  id String @id @default(cuid())
  universityId String
  userId String
  facultyId String
  @@unique([universityId,userId,facultyId])
}
model StaffTask {
  id String @id @default(cuid())
  universityId String
  studentId String?
  assignedTo String?
  reason String
  deduplicationKey String @unique
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([universityId,resolvedAt])
}
model AuditLog {
  id String @id @default(cuid())
  universityId String
  actorId String
  action String
  entityId String
  createdAt DateTime @default(now())
  @@index([universityId,createdAt])
}
model SystemSetting {
  id String @id @default(cuid())
  universityId String
  key String
  value Json
  @@unique([universityId,key])
}
model Permission {
  id String @id @default(cuid())
  role Role
  resource String
  action String
  @@unique([role,resource,action])
}
